{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["api/**/*.ts", "src/**/*.ts"],
	"exclude": ["src/replay/seeds/**/base", "src/replay/seeds/**/head"]
}
