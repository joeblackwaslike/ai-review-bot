{
	"name": "ai-review-bot",
	"version": "0.3.0",
	"description": "GitHub App that runs parallel AI code review agents (Claude + Codex) on every pull request",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/joeblackwaslike/ai-review-bot.git"
	},
	"homepage": "https://joeblackwaslike.github.io/ai-review-bot/",
	"license": "MIT",
	"author": "Joe Black <joeblackwaslike@gmail.com>",
	"keywords": [
		"code-review",
		"github-app",
		"claude",
		"openai",
		"ai",
		"pull-request",
		"static-analysis"
	],
	"bin": {
		"ai-review": "dist/cli.js"
	},
	"files": [
		".ai-review.yaml",
		"dist/",
		"skills/"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vercel dev",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "pnpm build && pnpm typecheck && pnpm test",
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"config:check": "bun scripts/config-check.ts",
		"docs:config": "bun scripts/gen-config-docs.ts",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.135",
		"@ai-sdk/google": "3.0.137",
		"@ai-sdk/openai": "^3.0.131",
		"@ai-sdk/provider": "^3.0.19",
		"@anthropic-ai/sdk": "^0.39.0",
		"@upstash/qstash": "^2.11.1",
		"@upstash/redis": "^1.38.0",
		"@vercel/functions": "^3.4.4",
		"@vercel/node": "^3.2.25",
		"ai": "^6.0.315",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"octokit": "^4.0.2",
		"pg": "^8.22.0",
		"yaml": "^2.9.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@types/node": "^22.15.3",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"pg-mem": "^3.0.14",
		"typescript": "^7.0.2",
		"vitepress": "^1.6.4",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@11.0.8"
}
